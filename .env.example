DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=nome_do_banco
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# TLS/SSL da conexão MySQL. Local: false (sem TLS). No Azure Flexible Server: true.
DB_SSL=false
# Opcional no Azure: caminho do certificado CA (DigiCert Global Root G2),
# recomendado pela Microsoft para validar o servidor.
# DB_SSL_CA=./certs/DigiCertGlobalRootG2.crt.pem
